# ---------- 基础（阶段 0 起）----------
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/travel_memory
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_VERSION=bge-m3@v1
EMBEDDING_DIM=1024
LLM_API_KEY=
LLM_BASE_URL=
AGENT_RUNTIME=pipeline                  # pipeline | graph（阶段 4 切换）
LLM_DAILY_BUDGET_CENTS=2000             # 日成本硬上限，Redis 原子计数
LOG_LEVEL=INFO

# provider 开关：auto 表示「配了 Key 走真实服务，没配就降级为本地占位实现」
#  - mock LLM：本地规则作答（不能作为效果评估）
#  - hashing embedding：本地哈希向量（只认字面相似，不能作为检索质量结论）
LLM_PROVIDER=auto                       # auto | openai | mock
LLM_MODEL=deepseek-chat
EMBEDDING_PROVIDER=auto                 # auto | openai | hashing
EMBEDDING_BASE_URL=                     # 留空时复用 LLM_BASE_URL
EMBEDDING_API_KEY=                      # 留空时复用 LLM_API_KEY

# 检索与上下文
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.30                # 低于该相似度的证据不进上下文
CONTEXT_MAX_CHARS=4000
DEMO_USER_NAME=我

# ---------- 阶段 3+ ----------
REDIS_URL=redis://localhost:6379/0
AMAP_API_KEY=
AMAP_JS_KEY=
RERANK_MODEL=bge-reranker-v2-m3         # 无 GPU 时改用 Qwen rerank API

# ---------- 阶段 6+ ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123

# ---------- 科研轨（阶段 7，全部默认关闭）----------
PRIVACY_ENABLED=false
SEMANTIC_ENABLED=false
ZK_ENABLED=false
CHAIN_ENABLED=false

PRIVACY_VERSION=privacy-2026.1
PRIVACY_DEFAULT_EPSILON=1.0             # km^-1
PRIVACY_DEFAULT_MECHANISM=geo_indistinguishability
PRIVACY_SEMANTIC_UMAX=0.3               # 语义感知扰动的效用损失上限
PRIVACY_K_ANONYMITY=5                   # 模式发布最小支持度

SEMANTIC_TAG_VERSION=sem-2026.1
SEMANTIC_MAX_SEQ_LEN=6                  # 语义序列截断长度，降低重识别风险
SEMANTIC_MIN_SCORE=4.0                  # 进入模式库的评分门槛

ZK_SCHEME=none                          # none | merkle_sig | groth16 | halo2
ZK_CIRCUIT_VERSION=route-v1
ZK_EXECUTOR=subprocess
ZK_TIMEOUT_SEC=30
CHAIN_BACKEND=local                     # local | ots | sepolia
CHAIN_RPC_URL=
CHAIN_CONTRACT_ADDR=
CHAIN_PRIVATE_KEY=                      # 仅测试网，绝不填主网
